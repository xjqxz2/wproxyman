# ============================================================================
# WProxyman — .gitignore
# 保持仓库干净：只提交源码，排除构建产物、依赖、本地生成文件。
# ============================================================================

# --- 构建产物 ---------------------------------------------------------------
build/bin/
build/*.exe
*.exe
*.dmg
*.AppImage
*.deb
bin/

# --- 前端（依赖 / 构建输出 / 自动生成）--------------------------------------
frontend/node_modules/
frontend/dist/
# Monaco 本地副本由 scripts/copy-monaco.mjs 自动生成
frontend/public/monaco/
# Wails 自动生成的 TS 绑定（构建时重新生成）
frontend/wailsjs/

# --- 开发工具 / IDE ----------------------------------------------------------
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
*.log

# --- 环境变量（可能含敏感信息）-----------------------------------------------
.env
.env.*

# --- 本机工具索引 ------------------------------------------------------------
.codegraph/
